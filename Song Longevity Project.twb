    <worksheet name='Does Going Viral Help a Song Last?'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;&#10;</run>
            <run fontalignment='1' fontsize='12'>Songs grouped by virality level from low to high</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='song_longevity.csv (Multiple Connections)' name='federated.0be0aso0i2dcdh10t3rjq03i3m4n' />
          </datasources>
          <datasource-dependencies datasource='federated.0be0aso0i2dcdh10t3rjq03i3m4n'>
            <column caption='Half-life vs tier avg' datatype='real' name='[Calculation_4164729156243456]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[halflife_days] - {FIXED [label_tier] : AVG([halflife_days])}' />
            </column>
            <column caption='Virality Level' datatype='string' name='[Calculation_4164729160114177]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [tiktok_virality] &lt;= 0.5 THEN &quot;1. 0-0.5&quot;&#13;&#10;ELSEIF [tiktok_virality] &lt;= 1 THEN &quot;2. 0.5-1&quot;&#13;&#10;ELSEIF [tiktok_virality] &lt;= 2 THEN &quot;3. 1-2&quot;&#13;&#10;ELSEIF [tiktok_virality] &lt;= 3 THEN &quot;4. 2-3&quot;&#13;&#10;ELSEIF [tiktok_virality] &lt;= 5 THEN &quot;5. 3-5&quot;&#13;&#10;ELSE &quot;6. 5+&quot; END' />
              <aliases>
                <alias key='&quot;1. 0-0.5&quot;' value='Less Viral' />
                <alias key='&quot;2. 0.5-1&quot;' value=' ' />
                <alias key='&quot;3. 1-2&quot;' value='  ' />
                <alias key='&quot;4. 2-3&quot;' value='   ' />
                <alias key='&quot;5. 3-5&quot;' value='    ' />
                <alias key='&quot;6. 5+&quot;' value='Very Viral' />
              </aliases>
            </column>
            <column-instance column='[Calculation_4164729156243456]' derivation='Avg' name='[avg:Calculation_4164729156243456:qk]' pivot='key' type='quantitative' />
            <column caption='Halflife Days' datatype='integer' name='[halflife_days]' role='measure' type='quantitative' />
