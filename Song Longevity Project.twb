      <column caption='First Month Stream Tier' datatype='integer' name='[Calculation_1881868630036480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [first_month_streams] &lt; 10000 THEN 1&#13;&#10;ELSEIF [first_month_streams] &lt; 50000 THEN 2&#13;&#10;ELSEIF [first_month_streams] &lt; 100000 THEN 3&#13;&#10;ELSEIF [first_month_streams] &lt; 500000 THEN 4&#13;&#10;ELSE 5&#13;&#10;END' />
      </column>
      <column caption='Playlist Addition Tier' datatype='integer' name='[Calculation_1881868637716481]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [playlist_adds_first_month] = 0 THEN 1&#13;&#10;ELSEIF [playlist_adds_first_month] &lt;= 5 THEN 2&#13;&#10;ELSEIF [playlist_adds_first_month] &lt;= 10 THEN 3&#13;&#10;ELSEIF [playlist_adds_first_month] &lt;= 20 THEN 4&#13;&#10;ELSE 5&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='Artist Audience Tier' datatype='integer' name='[Calculation_1881868647403522]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [artist_prior_monthly_listeners] &lt; 10000 THEN 1&#13;&#10;ELSEIF [artist_prior_monthly_listeners] &lt; 100000 THEN 2&#13;&#10;ELSEIF [artist_prior_monthly_listeners] &lt; 1000000 THEN 3&#13;&#10;ELSEIF [artist_prior_monthly_listeners] &lt; 10000000 THEN 4&#13;&#10;ELSE 5&#13;&#10;END' />
        <aliases>
          <alias key='1' value='Under 10K Listeners' />
          <alias key='2' value='10K to 100K Listeners' />
          <alias key='3' value='100K to 1M Listeners' />
          <alias key='4' value='1M to 10M Listeners' />
          <alias key='5' value='Over 10M Listeners' />
        </aliases>
      </column>
      <column caption='Collaboration Status' datatype='string' name='[Calculation_1881868653735939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [featured_artist] = 1 THEN&#13;&#10;    &quot;Featured Artist&quot;&#13;&#10;ELSE&#13;&#10;    &quot;No Featured Artist&quot;&#13;&#10;END' />
      </column>
      <column caption='Audience Tier Label' datatype='string' name='[Calculation_1881868661518341]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_1881868647403522]&#13;&#10;WHEN 1 THEN &quot;1. Under 10K listeners&quot;&#13;&#10;WHEN 2 THEN &quot;2. 10K to 100K listeners&quot;&#13;&#10;WHEN 3 THEN &quot;3. 100K to 1M listeners&quot;&#13;&#10;WHEN 4 THEN &quot;4. 1M to 10M listeners&quot;&#13;&#10;WHEN 5 THEN &quot;5. 10M+ listeners&quot;&#13;&#10;END' />
      </column>
      <column caption='Editorial Placement Status' datatype='string' name='[Calculation_1881868664655878]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [editorial_playlist] = 1 THEN&#13;&#10;    &quot;Editorial Placement&quot;&#13;&#10;ELSE&#13;&#10;    &quot;No Editorial Placement&quot;&#13;&#10;END' />
      </column>
      <column caption='Playlist Exposure Tier' datatype='string' name='[Calculation_1881868665737223]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [playlist_adds_first_month] = 0 THEN&#13;&#10;    &quot;1. No Playlist Additions&quot;&#13;&#10;ELSEIF [playlist_adds_first_month] &lt;= 5 THEN&#13;&#10;    &quot;2. 1 to 5 Playlist Additions&quot;&#13;&#10;ELSEIF [playlist_adds_first_month] &lt;= 10 THEN&#13;&#10;    &quot;3. 6 to 10 Playlist Additions&quot;&#13;&#10;ELSEIF [playlist_adds_first_month] &lt;= 20 THEN&#13;&#10;    &quot;4. 11 to 20 Playlist Additions&quot;&#13;&#10;ELSE&#13;&#10;    &quot;5. 21+ Playlist Additions&quot;&#13;&#10;END' />
        <aliases>
